{
  "name": "qa-sentinel-tyra",
  "version": "1.0.0",
  "private": true,
  "description": "QA Sentinel Tyra - a Playwright-powered quality intelligence platform with live dashboards, issue classification, release readiness and executive reporting.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=nation-chromium --project=ai-skills-chromium",
    "test:chromium:headed": "playwright test --project=nation-chromium --project=ai-skills-chromium --headed",
    "test:nation": "playwright test tests/nation --project=nation-chromium --headed",
    "test:nation:ci": "playwright test tests/nation --project=nation-chromium",
    "test:skills": "playwright test tests/skills --project=ai-skills-chromium --headed",
    "test:skills:ci": "playwright test tests/skills --project=ai-skills-chromium",
    "test:ux-ui": "playwright test tests/nation/ux-intelligence.spec.ts tests/skills/ux-intelligence.spec.ts --project=nation-chromium --project=ai-skills-chromium --no-deps",
    "test:ux-ui:matrix": "playwright test tests/nation/ux-intelligence.spec.ts tests/skills/ux-intelligence.spec.ts --no-deps",
    "test:discovered": "playwright test tests/generated/discovered-pages-nation.spec.ts tests/generated/discovered-pages-ai-skills.spec.ts --project=nation-chromium --project=ai-skills-chromium",
    "test:discovered:nation": "playwright test tests/generated/discovered-pages-nation.spec.ts --project=nation-chromium",
    "test:discovered:skills": "playwright test tests/generated/discovered-pages-ai-skills.spec.ts --project=ai-skills-chromium",
    "test:all": "playwright test",
    "test:all:headed": "playwright test --headed",
    "qa": "node scripts/run-qa.mjs",
    "qa:full": "npm run scan:all && npm run qa",
    "qa:sites": "node scripts/qa-sites.mjs",
    "qa:unattended": "node scripts/qa-unattended.mjs",
    "qa:pentest": "node scripts/qa-pentest.mjs",
    "qa:pentest:production": "node scripts/qa-pentest.mjs --mode production-safe",
    "qa:pentest:staging": "node scripts/qa-pentest.mjs --mode staging-active",
    "qa:pentest:manual": "node scripts/qa-pentest.mjs --mode manual-validation",
    "qa:nation": "node scripts/qa-sites.mjs --nation-only",
    "qa:skills": "node scripts/qa-sites.mjs --skills-only",
    "qa:matrix": "node scripts/qa-matrix.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "qa:browsers": "node scripts/qa-matrix.mjs",
    "qa:compat": "node scripts/qa-compat.mjs",
    "scan": "node scripts/scan-site.mjs",
    "scan:nation": "node scripts/scan-site.mjs https://nation.dev/ nation",
    "scan:skills": "node scripts/scan-site.mjs https://aiskills.nation.dev/ ai-skills",
    "scan:all": "npm run scan:nation && npm run scan:skills",
    "dashboard": "node scripts/start-dashboard-with-auth.mjs",
    "report": "playwright show-report",
    "start:local": "node scripts/start-local.mjs",
    "start:windows": "node scripts/qa-sentinel-launcher.cjs",
    "check:windows": "node scripts/qa-sentinel-launcher.cjs --check",
    "build:exe": "npm run build:exe:raw && npm run build:exe:icon",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:ci": "npm run typecheck && npm run test:unit",
    "validate": "npm run typecheck && npm run test:all",
    "dashboard:sample": "node scripts/seed-dashboard-sample.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "report:traceability": "node scripts/report-traceability.mjs",
    "sentinel": "node scripts/sentinel.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['test-results','playwright-report','blob-report']) fs.rmSync(p,{recursive:true,force:true});\"",
    "qa:demo": "npm run scan:all && node scripts/qa-demo.mjs",
    "build:exe:raw": "pkg scripts/qa-sentinel-launcher.cjs --targets node20-win-x64 --output dist/QA-Sentinel-Tyra.raw.exe",
    "build:exe:icon": "node scripts/build-exe-final.cjs",
    "scan:nation:auth": "node scripts/run-authenticated-scan.mjs https://nation.dev/ nation playwright/.auth/nation.json /home /profile /jobs /benchmarks",
    "scan:deep": "npm run scan:nation && npm run scan:nation:auth && npm run scan:skills && npm run scan:skills:auth && npm run scan:coverage",
    "scan:coverage": "node scripts/build-discovery-coverage.mjs",
    "scan:nation:deep": "npm run scan:nation && npm run scan:nation:auth && npm run scan:coverage",
    "scan:skills:auth": "node scripts/run-authenticated-scan.mjs https://aiskills.nation.dev/ ai-skills playwright/.auth/ai-skills.json /my-pathway",
    "scan:skills:deep": "npm run scan:skills && npm run scan:skills:auth && npm run scan:coverage",
    "dashboard:plain": "node scripts/serve-dashboard.mjs",
    "auth:nation:refresh": "node scripts/auth-refresh.mjs nation",
    "auth:skills:refresh": "node scripts/auth-refresh.mjs ai-skills"
  },
  "keywords": [
    "qa",
    "playwright",
    "typescript",
    "test-automation",
    "quality-intelligence",
    "qa-dashboard",
    "release-readiness",
    "test-reporting",
    "website-scanner",
    "tyra-labs"
  ],
  "author": "Petter Wastesson",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peppe2236/qa-sentinel-tyra.git"
  },
  "homepage": "https://github.com/Peppe2236/qa-sentinel-tyra#readme",
  "bugs": {
    "url": "https://github.com/Peppe2236/qa-sentinel-tyra/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@yao-pkg/pkg": "^6.10.0",
    "resedit-cli": "^3.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pdfkit": "^0.19.1"
  }
}
