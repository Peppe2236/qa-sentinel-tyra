# Copy to .env in the project root. Never commit .env.
# Ubuntu/WSL:
#   cp .env.example .env
#   nano .env

# -----------------------------------------------------------------------------
# GitHub (optional local gh / issue publishing on THIS repo only)
# Not required to run Playwright. Do not paste a production token into git.
# Issue creation stays off unless QA_CREATE_ISSUES=1 AND a token is set.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REPOSITORY=Peppe2236/qa-sentinel-tyra
GITHUB_SHA=
GITHUB_REF=
GITHUB_ACTIONS=
QA_CREATE_ISSUES=0

# -----------------------------------------------------------------------------
# Optional real login accounts
# If both email and password are set, `npm run qa:unattended` logs in once
# (storageState) and hits member routes with no prompt.
# If they are empty, those tests skip and the human review pack lists one item:
# "Add test account to unlock /home /jobs /profile /assessment"
# Use a disposable QA account, never a personal production password.
# -----------------------------------------------------------------------------
NATION_TEST_EMAIL=
NATION_TEST_PASSWORD=

AI_SKILLS_TEST_EMAIL=
AI_SKILLS_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# Local dashboard and scanner
# -----------------------------------------------------------------------------
QA_DASHBOARD_PORT=4173
# Bounded scan used by `npm run qa:sites`. Keep this small so CI/local
# discovery does not crawl forever. The live sites currently have ~12–13
# public routes; 20 is a ceiling, not a target.
QA_MAX_PAGES=20
QA_NAV_TIMEOUT=30000
QA_SCAN_URL=
QA_SCAN_SITE=

# Playwright sets CI=true in GitHub Actions. Leave unset locally.
# CI=

# -----------------------------------------------------------------------------
# Optional LLM enrichment (heuristic Sentinel AI always runs)
# Without a key the dashboard shows: LLM off — no key
# -----------------------------------------------------------------------------
SENTINEL_LLM_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# SENTINEL_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# First-party captcha (nation.dev and aiskills.nation.dev only)
# Cookie/consent banners and native checkboxes are clicked unattended.
# Google reCAPTCHA / hCaptcha iframes: detect, screenshot, human-queue.
# Paid solver stays OFF unless SENTINEL_CAPTCHA_SOLVER_KEY is set.
# Never solve captchas on arbitrary third-party sites.
# -----------------------------------------------------------------------------
SENTINEL_CAPTCHA_SOLVER_KEY=
# SENTINEL_CAPTCHA_SOLVER=2captcha
# SENTINEL_CAPTCHA_SOLVER=capsolver

# -----------------------------------------------------------------------------
# Autonomous QA
# Advisory + local remediation/release reports default ON.
# Production writes against nation.dev stay off even if execution is set.
# -----------------------------------------------------------------------------
QA_AUTONOMOUS_REMEDIATION=1
# QA_AUTONOMOUS_EXECUTION=false
