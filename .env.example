# Copy to .env in the project root. Never commit .env.
# Ubuntu/WSL:
#   cp .env.example .env
#   nano .env

# -----------------------------------------------------------------------------
# GitHub (optional local gh / future issue publishing)
# Not required to run Playwright. Do not paste a production token into git.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY=Peppe2236/qa-sentinel-tyra
GITHUB_SHA=
GITHUB_REF=
GITHUB_ACTIONS=

# -----------------------------------------------------------------------------
# Optional real login accounts
# Current auth tests only prove that sign-in/sign-up forms render and accept
# input. Real session tests stay skipped until these are set.
# Use a disposable QA account, never a personal production password.
# -----------------------------------------------------------------------------
NATION_TEST_EMAIL=
NATION_TEST_PASSWORD=

AI_SKILLS_TEST_EMAIL=
AI_SKILLS_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# Local dashboard and scanner
# -----------------------------------------------------------------------------
QA_DASHBOARD_PORT=4173
QA_MAX_PAGES=50
QA_NAV_TIMEOUT=30000
QA_SCAN_URL=
QA_SCAN_SITE=

# Playwright sets CI=true in GitHub Actions. Leave unset locally.
# CI=
