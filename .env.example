# Copy to .env in the project root. Never commit .env.
# Ubuntu/WSL:
#   cp .env.example .env
#   nano .env

# -----------------------------------------------------------------------------
# GitHub (optional local gh / future issue publishing)
# Not required to run Playwright. Do not paste a production token into git.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY=Peppe2236/qa-sentinel-tyra
GITHUB_SHA=
GITHUB_REF=
GITHUB_ACTIONS=

# -----------------------------------------------------------------------------
# Optional real login accounts
# If both email and password are set, `npm run qa:unattended` logs in once
# (storageState) and hits member routes with no prompt.
# If they are empty, those tests skip and the human review pack lists one item:
# "Add test account to unlock /home /jobs /profile /assessment"
# Use a disposable QA account, never a personal production password.
# -----------------------------------------------------------------------------
NATION_TEST_EMAIL=
NATION_TEST_PASSWORD=

AI_SKILLS_TEST_EMAIL=
AI_SKILLS_TEST_PASSWORD=

# -----------------------------------------------------------------------------
# Local dashboard and scanner
# -----------------------------------------------------------------------------
QA_DASHBOARD_PORT=4173
# Bounded scan used by `npm run qa:sites`. Keep this small so CI/local
# discovery does not crawl forever. The live sites currently have ~12–13
# public routes; 20 is a ceiling, not a target.
QA_MAX_PAGES=20
QA_NAV_TIMEOUT=30000
QA_SCAN_URL=
QA_SCAN_SITE=

# Playwright sets CI=true in GitHub Actions. Leave unset locally.
# CI=
